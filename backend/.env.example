# Server
PORT=5000
NODE_ENV=development

# MongoDB — local default, or paste your Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/linux_hub

# Frontend URL allowed by CORS (Vite default)
CLIENT_URL=http://localhost:5173

# Auth — secret for signing JWTs (change it!)
JWT_SECRET=change_me

# Sign in with Google (One Tap prompt — no client secret needed) — OAuth
# client ID from https://console.cloud.google.com/apis/credentials
# (must match VITE_GOOGLE_CLIENT_ID in the frontend env)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# AI assistant (Groq) — get keys at https://console.groq.com/keys
# Up to 5 keys: comma-separated and/or numbered. A 429/401 on one key
# automatically rolls to the next (429 rests 60s, 401 rests 10 min).
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b

# Find-Your-Distro quiz (Jev via TypeSafe) — get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Password-reset email (Gmail example — use an App Password, never your login password)
# RESET_DELIVERY=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=DistroPedia <you@gmail.com>
