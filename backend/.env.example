# Server
PORT=5000
NODE_ENV=development

# MongoDB — local default, or paste your Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/linux_hub

# Frontend URL allowed by CORS (Vite default)
CLIENT_URL=http://localhost:5173

# Auth — secret for signing JWTs (change it!)
JWT_SECRET=change_me

# AI assistant (Groq) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Find-Your-Distro quiz (Jev via TypeSafe) — get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Password-reset email (Gmail example — use an App Password, never your login password)
# RESET_DELIVERY=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=DistroPedia <you@gmail.com>
