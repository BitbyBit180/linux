# Server
PORT=5000
NODE_ENV=development

# MongoDB — local default, or paste your Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/linux_hub

# Frontend URL allowed by CORS (Vite default)
CLIENT_URL=http://localhost:5173

# Auth — secret for signing JWTs (change it!)
JWT_SECRET=change_me

# AI assistant (Google Gemini) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
