# Copy to .env for local development (Vite reads frontend/.env)
# Backend URL for /api calls (dev default uses the Vite proxy instead)
# VITE_API_URL=http://localhost:5000/api

# Sign in with Google — OAuth client ID from https://console.cloud.google.com/apis/credentials
# (must match GOOGLE_CLIENT_ID in backend/.env; empty hides the Google button)
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
